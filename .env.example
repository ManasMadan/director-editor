# Copy to .env (`bun run setup` does it for you). Every app reads this one file.
# Variables are validated at startup/build time; see apps/api/src/env.ts and apps/web/src/env.ts.

# ---- Local service ports (docker-compose.yml) ----
# Change one if something on your machine already uses it, and update the matching URL.
# `bun run setup --stack <n>` moves every *_PORT here and below, and the URLs naming them.
# They listen on this address only; 0.0.0.0 opens them to your network (docker-compose.yml).
DOCKER_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=55432
VALKEY_PORT=56379
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
S3_PORT=59000
S3_CONSOLE_PORT=59001
CLAMAV_PORT=53310
STALWART_SMTPS_PORT=51465
STALWART_HTTP_PORT=58080
JAEGER_OTLP_PORT=54318
JAEGER_UI_PORT=56686

# ---- Local app ports (bun dev, the e2e run, the dev tools) ----
# Where each app listens on this machine. Containers don't read these: the Nest services
# listen on PORT when it's set (the charts set it) and the images bring their own.
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002
NOTIFICATIONS_PORT=3003
WEBHOOKS_PORT=3004
# The mobile app's web build (apps/mobile `bun run serve:web`, the mobile e2e suite).
MOBILE_WEB_PORT=3005
AI_PORT=8000
# Email previews (packages/email), Expo's bundler (apps/mobile), Storybook (packages/ui).
EMAIL_PREVIEW_PORT=3030
EXPO_PORT=8081
STORYBOOK_PORT=6006
# The fake Stripe (`bun run stripe:fake`, the e2e run).
STRIPE_FAKE_PORT=12111

# ---- Database (matches docker-compose.yml) ----
# Each service connects as its own Postgres role with only the privileges it needs
# (see infra/postgres/init). Migrations connect as the owner role, `migrator`.
MIGRATOR_DATABASE_URL=postgresql://migrator:migrator@localhost:55432/app
# Used by `prisma migrate dev` to detect drift; never holds real data.
SHADOW_DATABASE_URL=postgresql://migrator:migrator@localhost:55432/app_shadow
API_DATABASE_URL=postgresql://app_api:app_api@localhost:55432/app
WORKER_DATABASE_URL=postgresql://app_worker:app_worker@localhost:55432/app
# The outbox relay LISTENs for new events, which needs a direct (non-pooled) connection.
WORKER_DATABASE_DIRECT_URL=postgresql://app_worker:app_worker@localhost:55432/app
NOTIFICATIONS_DATABASE_URL=postgresql://app_notifications:app_notifications@localhost:55432/app
WEBHOOKS_DATABASE_URL=postgresql://app_webhooks:app_webhooks@localhost:55432/app
AI_DATABASE_URL=postgresql://app_ai:app_ai@localhost:55432/app

# ---- Redis / Valkey (sessions, cache, rate limits, queues) ----
REDIS_URL=redis://localhost:56379

# ---- Email (apps/notifications sends; apps/webhooks receives bounces) ----
# Locally email goes to Mailpit (open http://localhost:58025 to read every email). In
# production it's submitted to our Stalwart mail server as its no-reply account, over TLS:
# smtps://no-reply%40example.com:<password>@mail.example.com:465 (what production
# requires: apps/notifications/src/channels/email/smtp-url.ts).
SMTP_URL=smtp://localhost:51025
# Where tests read the caught emails (Mailpit's API).
MAILPIT_URL=http://localhost:58025
# With Stalwart, an address of the account SMTP_URL signs in as.
EMAIL_FROM=Boilerplate <no-reply@example.com>
# The key Stalwart signs its webhook to <site>/webhooks/stalwart with (a hard bounce then
# stops all email to that address; unset switches the route off). `bun run setup`
# generates it and docker compose gives the local Stalwart the same value. To rotate,
# list the new and the old key comma-separated, give Stalwart the new one, drop the old.
STALWART_WEBHOOK_SECRET=change-me
# The prod-like mail path locally: `bun run db:up:mail` starts Stalwart (docker-compose.yml
# explains its setup). To send through it instead of Mailpit:
#   SMTP_URL=smtps://no-reply:no-reply-password@localhost:51465?tls.rejectUnauthorized=false
#   EMAIL_FROM=Boilerplate <no-reply@boilerplate.test>
# To run the integration tests that prove that path, set both of these:
# STALWART_URL=http://localhost:58080
# STALWART_SMTP_URL=smtps://no-reply:no-reply-password@localhost:51465?tls.rejectUnauthorized=false
# Its local credentials default to STALWART_ADMIN_PASSWORD=stalwart-admin and
# STALWART_SMTP_PASSWORD=no-reply-password; set them here to change them.

# Encrypts secrets stored in the database (webhook signing secrets). "id:base64key", the
# first key encrypts, any listed key decrypts; prepend a new one to rotate. `bun run
# setup` generates it; by hand: echo "$(date +%Y-%m):$(openssl rand -base64 32)".
ENCRYPTION_KEYS=change-me
# Signs one-click unsubscribe links in emails (apps/notifications signs, apps/api checks).
UNSUBSCRIBE_SECRET=change-me

# ---- Files (apps/api signs uploads, apps/worker checks them) ----
# Off until S3_BUCKET is set. Locally: `docker compose --profile files up -d` (RustFS and
# ClamAV), then S3_BUCKET=uploads. In a cluster the stack takes all of these from the
# data chart's RustFS (its `storage` Secret).
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=rustfs-secret
S3_FORCE_PATH_STYLE=true
# The storage origin browsers upload to and load files from (for the web app's CSP).
STORAGE_ORIGIN=http://localhost:59000
# clamd, which scans every upload. FILE_SCANNER=none skips scanning (development only).
CLAMAV_URL=tcp://localhost:53310

# ---- Texts (apps/notifications): security codes and alerts ----
# "email" (local default) delivers texts to Mailpit as emails to <digits>@sms.test.
# In production use twilio, with a sender number or a Messaging Service SID (MG...).
SMS_PROVIDER=email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Push (apps/notifications; apps/api hands the VAPID public key to browsers) ----
# Each platform is on when all of its variables are set. Browsers (Web Push): a VAPID
# key pair, generated by `bun run setup` (by hand: bunx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:dev@example.com
# Android (FCM): a Firebase service account (Project settings, Service accounts).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# iOS (APNs): an auth key (.p8) from the Apple Developer account. Development builds use
# https://api.sandbox.push.apple.com.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_URL=https://api.push.apple.com

# ---- API (apps/api) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Rotating it (never replace it outright: what it encrypted would become unreadable):
# versioned secrets, newest first, then `bun run secrets:reencrypt`. See the
# rotate-secrets skill.
# BETTER_AUTH_SECRETS=1:<openssl rand -base64 48>
# Public URL users reach the app on. The API is served on the same origin (/rpc, /api),
# so auth cookies are first-party; OAuth callbacks and links are built from it.
BETTER_AUTH_URL=http://localhost:3000
# Browser origin allowed to call the API (same as BETTER_AUTH_URL unless split).
WEB_URL=http://localhost:3000
# Other origins of this product allowed to sign users in, comma-separated: the mobile
# app's web build (apps/mobile `bun run serve:web`, on MOBILE_WEB_PORT).
# Native apps need nothing here.
APP_ORIGINS=http://localhost:3005
# ---- Billing (apps/api; apps/webhooks receives Stripe's events) ----
# Off until STRIPE_SECRET_KEY and both prices are set: then Free/Pro plans apply.
# Real test mode: your sk_test_ key, two recurring prices, and `stripe listen
# --forward-to localhost:<WEBHOOKS_PORT>/webhooks/stripe` for STRIPE_WEBHOOK_SECRET below.
# Offline: `bun run stripe:fake` with any sk_test_/whsec_ values, any price ids starting
# with price_, and STRIPE_API_URL=http://127.0.0.1:<STRIPE_FAKE_PORT>.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_TRIAL_DAYS=14
STRIPE_API_URL=

# ---- Webhooks (apps/webhooks, and apps/api for endpoint settings) ----
# Stripe's signing secret for /webhooks/stripe (from `stripe listen` locally, or the
# Stripe dashboard). Leave empty to switch the route off.
STRIPE_WEBHOOK_SECRET=
# Exact private IPs customer webhook endpoints may use: loopback for local testing only.
# Must be empty in production (the services refuse to start otherwise).
WEBHOOK_ALLOWED_PRIVATE_ADDRESSES=127.0.0.1

# ---- AI (apps/ai, the Python service; apps/api calls it) ----
# Also where the web server forwards /ai/mcp (the AI service's MCP server) locally.
AI_URL=http://localhost:8000
# apps/api signs every call to the AI service with this; both read it. `bun run setup`
# generates it.
AI_SERVICE_SECRET=change-me
# The assistant's model (a Pydantic AI name, e.g. anthropic:claude-sonnet-5 with
# ANTHROPIC_API_KEY set, or openai:gpt-5 with OPENAI_API_KEY), and an optional fallback.
# local:extractive answers by quoting your documents, with no model: development only.
AI_MODEL=local:extractive
AI_FALLBACK_MODEL=
# Embeddings for search: hashing (local, development only) or a Pydantic AI embedding
# model such as openai:text-embedding-3-small.
AI_EMBEDDINGS=hashing
# Cosine similarity below which a passage isn't used at all (provider embeddings; 0 lets
# the model judge). Calibrate it for your embedding model with `bun run --cwd apps/ai evals`.
AI_MIN_RELEVANCE=0
# Monthly token allowance per workspace, and per answer.
AI_MONTHLY_TOKENS_PER_ORG=2000000
AI_TOKENS_PER_RUN=20000

# Optional: enable "Sign in with Google" by setting both.
# Redirect URI to register in Google Cloud: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Cloudflare Turnstile on sign-up, emailed codes and password reset (set both).
# Cloudflare's always-pass test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Refuse passwords found in public breaches (Have I Been Pwned). on in production by
# default, off otherwise; on means sign-ups fail while HIBP is unreachable.
# PASSWORD_BREACH_CHECK=off

# ---- Web (apps/web) ----
# Where the web server forwards /rpc and /api in local development (the gateway does it
# in deployed environments). Nothing environment-specific is built into the web bundle.
# apps/ai reads it too: its MCP server fetches the api's token signing keys from there.
API_URL=http://localhost:3001

# ---- Mobile (apps/mobile) ----
# Where a device reaches the site (the web app's URL; it forwards /rpc and /api). On a
# phone on your network use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
# The EAS project id (`bunx eas-cli init` in apps/mobile prints it). Needed only for EAS builds
# and over-the-air updates; the builds' EXPO_PUBLIC_API_URL is set per EAS environment
# (`bunx eas-cli env:create --environment production --name EXPO_PUBLIC_API_URL --value …`).
EAS_PROJECT_ID=
# Optional: the app's identifiers, for https links that open it (universal links, App
# Links) and its passkeys. Off while unset. apps/web serves
# /.well-known/apple-app-site-association and assetlinks.json from all four (unset, both
# answer 404; only some set, it refuses to start), app.config.ts claims the site's
# domain for each platform whose identifier the build has, and apps/api accepts passkeys
# from the Android app signed with each fingerprint. Use the identifiers of the build that
# talks to this site (app.config.ts adds .preview or .development for the other variants).
# The fingerprints are SHA-256, comma-separated: Play's app signing key and the EAS upload
# key (docs/web-and-mobile.md, "Universal links and App Links").
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=com.boilerplate.app
# ANDROID_PACKAGE=com.boilerplate.app
# ANDROID_CERT_FINGERPRINTS=

# ---- Telemetry (every service; off while unset) ----
# An OTLP/HTTP collector for traces and metrics. Locally Jaeger receives them: it's part
# of `bun run db:up:full` (or `docker compose --profile telemetry up -d jaeger` alone),
# and traces show at http://localhost:56686.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:54318

# ---- Tuning (every service has these defaults; uncomment to change one) ----
# NODE_ENV=development          # development | test | production
# LOG_LEVEL=info
# RELEASE=dev                   # the build's git SHA, stamped by CI into the images
# TRUSTED_PROXIES=loopback      # proxies whose X-Forwarded-For is believed (addresses/CIDRs)
# LOAD_SHEDDING=on              # answer 503 under sustained saturation
# PORT=                         # a Nest service's port, over its own *_PORT above (containers)
# API_DATABASE_POOL_MAX=10      # connections per process
# WORKER_DATABASE_POOL_MAX=10
# NOTIFICATIONS_DATABASE_POOL_MAX=10
# WEBHOOKS_DATABASE_POOL_MAX=10
# AI_DATABASE_POOL_MAX=5
# MINIMUM_CLIENT_VERSION=0.0.0  # older mobile builds are asked to update
# ALERTMANAGER_URL=             # the cluster's Alertmanager, for system.alerting (charts set it)
# Worker: the outbox relay, retention and file processing.
# RELAY_BATCH_SIZE=100
# RELAY_POLL_INTERVAL_MS=1000
# AUDIT_CONCURRENCY=20
# OUTBOX_RETENTION_DAYS=7
# PROCESSED_EVENT_RETENTION_DAYS=30
# AUDIT_RETENTION_MONTHS=13
# WEBHOOK_HISTORY_DAYS=30
# NOTIFICATION_HISTORY_DAYS=90
# FILES_CONCURRENCY=2
# FILE_SCANNER=clamav           # none skips virus scanning (only where ClamAV can't run)
# Notifications.
# NOTIFICATIONS_CRITICAL_CONCURRENCY=20
# NOTIFICATIONS_BULK_CONCURRENCY=5
# DIGEST_HOUR=8                 # local hour the daily digest goes out
# Webhooks (outbound delivery).
# WEBHOOK_DELIVERY_CONCURRENCY=20
# WEBHOOK_TIMEOUT_MS=15000
# WEBHOOK_AUTO_DISABLE_HOURS=120  # an endpoint failing this long is switched off
# Tests only: point providers at the local fakes.
# TWILIO_API_URL=
# FCM_TOKEN_URL=
# FCM_API_URL=
# WEB_PUSH_TEST_ORIGIN=
