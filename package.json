{
  "name": "boilerplate",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "load"
    ],
    "catalog": {
      "@better-auth/api-key": "^1.7.6",
      "@better-auth/cimd": "^1.7.6",
      "@better-auth/expo": "^1.7.6",
      "@better-auth/mcp": "^1.7.6",
      "@better-auth/oauth-provider": "^1.7.6",
      "@better-auth/passkey": "^1.7.6",
      "@better-auth/redis-storage": "^1.7.6",
      "@modelcontextprotocol/sdk": "^1.31.0",
      "@nestjs/bullmq": "^12.0.0",
      "@nestjs/common": "^12.1.1",
      "@nestjs/core": "^12.1.1",
      "@nestjs/platform-fastify": "^12.1.1",
      "@opentelemetry/api": "^1.9.1",
      "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
      "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
      "@opentelemetry/instrumentation": "^0.222.0",
      "@opentelemetry/instrumentation-http": "^0.222.0",
      "@opentelemetry/instrumentation-ioredis": "^0.70.0",
      "@opentelemetry/instrumentation-pg": "^0.74.0",
      "@opentelemetry/instrumentation-pino": "^0.68.0",
      "@opentelemetry/sdk-metrics": "^2.11.0",
      "@opentelemetry/sdk-node": "^0.222.0",
      "@orpc/client": "^1.15.4",
      "@orpc/contract": "^1.15.4",
      "@orpc/openapi": "^1.15.4",
      "@orpc/server": "^1.15.4",
      "@orpc/tanstack-query": "^1.15.4",
      "@orpc/zod": "^1.15.4",
      "@prisma/adapter-pg": "^7.10.0",
      "@prisma/client": "^7.10.0",
      "@t3-oss/env-core": "^0.13.11",
      "@t3-oss/env-nextjs": "^0.13.11",
      "@tailwindcss/postcss": "^4.3.3",
      "@tanstack/react-query": "^5.104.0",
      "@types/bun": "1.3.6",
      "@types/k6": "^2.3.0",
      "@types/node": "^26.6.3",
      "@types/react": "~19.2.0",
      "@types/react-dom": "~19.2.0",
      "@vitest/coverage-v8": "^5.0.2",
      "better-auth": "^1.7.6",
      "bullmq": "6.3.9",
      "fastify": "^5.12.5",
      "ioredis": "^6.0.0",
      "lucide-react": "^1.48.0",
      "next": "^16.3.6",
      "next-themes": "^0.4.6",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "prisma": "^7.10.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native-passkeys": "^0.4.2",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.2",
      "stripe": "^22.6.2",
      "tailwindcss": "^4.3.3",
      "tsdown": "^0.23.0",
      "typescript": "^6.0.3",
      "use-intl": "^4.14.7",
      "vitest": "^5.0.2",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "doctor": "bun scripts/doctor.ts",
    "env:set": "bun scripts/env-set.ts",
    "env:unset": "bun scripts/env-unset.ts",
    "dev": "bun scripts/setup.ts --env && bun run doctor && bun scripts/services.ts up && turbo run dev --filter=@repo/web --filter=@repo/api --filter=@repo/notifications --filter=@repo/worker --filter=@repo/webhooks",
    "dev:full": "bun scripts/setup.ts --env && bun run doctor && bun scripts/services.ts up --full && turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc -p scripts && tsc -p .claude/hooks && tsc -p turbo/generators",
    "lint": "bun scripts/lint.ts",
    "lint:unused": "knip",
    "lint:markers": "bun scripts/check-markers.ts",
    "lint:patterns": "bun scripts/check-patterns.ts",
    "lint:actionlint": "bun scripts/linters.ts actionlint",
    "lint:zizmor": "bun scripts/linters.ts zizmor",
    "lint:shellcheck": "bun scripts/linters.ts shellcheck",
    "lint:hadolint": "bun scripts/linters.ts hadolint",
    "lint:tflint": "bun scripts/linters.ts tflint",
    "lint:renovate": "bun scripts/linters.ts renovate",
    "lint:prisma": "bun scripts/format-prisma.ts --check",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:integration": "bun scripts/services.ts up && turbo run test:integration",
    "test:integration:files": "bun scripts/services.ts up --files && turbo run test:integration:files",
    "test:e2e": "bun --env-file=.env scripts/e2e.ts",
    "test:load": "bun run --cwd load test:load",
    "test:fuzz": "bun --env-file=.env scripts/fuzz.ts",
    "charts:check": "bun scripts/charts.ts",
    "infra:check": "bun scripts/infra.ts",
    "promote": "bun scripts/release.ts promote",
    "k8s:up": "bun scripts/k8s.ts up",
    "k8s:smoke": "bun scripts/k8s.ts smoke",
    "k8s:down": "bun scripts/k8s.ts down",
    "gen": "turbo run gen",
    "gen:new": "turbo gen",
    "db:up": "bun scripts/services.ts up",
    "db:up:mail": "bun scripts/services.ts up --mail",
    "db:up:full": "bun scripts/services.ts up --full",
    "db:down": "bun scripts/services.ts down",
    "db:lint": "bun scripts/lint-migrations.ts",
    "db:restore-drill": "bun scripts/restore-drill.ts",
    "docker:clean": "bun scripts/docker-clean.ts",
    "jobs": "bun --env-file=.env scripts/jobs.ts",
    "db:migrate": "bun run --filter @repo/db migrate",
    "db:deploy": "bun run --filter @repo/db deploy",
    "db:studio": "bun run --filter @repo/db studio",
    "db:reset": "bun run --filter @repo/db reset",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs && bun scripts/check-web-render-only.ts && bun scripts/check-layers.ts",
    "prepare": "husky",
    "stripe:fake": "bun run --filter @repo/fake-stripe start",
    "db:seed": "turbo run seed --filter=@repo/api",
    "secrets:reencrypt": "turbo run secrets:reencrypt --filter=@repo/api",
    "test:coverage": "turbo run coverage && bun test --coverage ./scripts/ ./.claude/hooks/ && bun scripts/coverage.ts",
    "lint:suppressions": "bun scripts/suppressions.ts",
    "rename": "bun scripts/rename.ts",
    "type-coverage": "bun scripts/type-coverage.ts",
    "codeql": "bun scripts/codeql.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@repo/jobs": "workspace:*",
    "@turbo/gen": "^2.11.5",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "playwright-core": "1.63.0",
    "turbo": "^2.11.5",
    "type-coverage": "2.29.7",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "deploy/{environments/*/secrets,platform/secrets/*}/*": "bun scripts/secrets-check.ts",
    "apps/ai/**/*.py": [
      "uv run --project apps/ai ruff check --fix",
      "uv run --project apps/ai ruff format"
    ],
    "*.prisma": "bun scripts/format-prisma.ts",
    "packages/db/prisma/migrations/**/migration.sql": "bun scripts/lint-migrations.ts",
    "*.{tf,tftest.hcl}": "bun scripts/tofu-fmt.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "js-yaml": "4.3.2",
    "mysql2": "3.23.1",
    "next": "catalog:",
    "uuid": "11.1.1"
  },
  "patchedDependencies": {
    "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch"
  }
}
