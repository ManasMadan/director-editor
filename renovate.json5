// Dependency updates, by Renovate running in this repository's Actions (renovate.yml).
// Everything is pinned, so nothing moves without a pull request that CI checks: npm and
// Python packages and their lockfiles, images, actions (by digest), Helm charts, OpenTofu
// providers and the tool versions pinned in scripts and workflows (the custom managers
// below; a `# renovate:` comment marks a version on the next line).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", ":semanticCommits", ":semanticCommitScope(deps)"],
  timezone: "Etc/UTC",
  schedule: ["before 6am on monday"],
  // A release must have been out this long first: most malicious or broken releases are
  // pulled within days.
  minimumReleaseAge: "3 days",
  prConcurrentLimit: 10,
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on monday"] },
  // Our charts don't use the repository/tag convention; their images are in a custom
  // manager below.
  "helm-values": { enabled: false },
  customManagers: [
    {
      description: "Bun's catalog in the root package.json (Renovate's Bun manager doesn't read catalogs)",
      customType: "regex",
      managerFilePatterns: ["/^package\\.json$/"],
      matchStringsStrategy: "recursive",
      matchStrings: ['"catalog": \\{[^}]*\\}', '"(?<depName>[^"]+)": "(?<currentValue>[^"]+)"'],
      datasourceTemplate: "npm",
      versioningTemplate: "npm",
    },
    {
      description: "Versions marked with a `# renovate:` (or `// renovate:`) comment",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/)[^/]*Dockerfile$/",
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^infra/tofu/.+\\.tf$/",
        "/^scripts/.+\\.ts$/",
        "/^\\.devcontainer/devcontainer\\.json$/",
      ],
      matchStrings: [
        "(?:#|//) renovate: datasource=(?<datasource>[\\w-]+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n[^\\n]*?(?<currentValue>v?\\d+\\.\\d+(?:\\.\\d+)?(?:-[\\w.]+)?(?:\\+[\\w.]+)?)\\b",
      ],
    },
    {
      description: "The Bun and Node versions EAS builds the mobile app with",
      customType: "regex",
      managerFilePatterns: ["/^apps/mobile/eas\\.json$/"],
      matchStrings: [
        '"(?<depName>bun)": "(?<currentValue>[^"]+)"',
        '"(?<depName>node)": "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "{{#if (equals depName 'node')}}node-version{{else}}npm{{/if}}",
    },
    {
      description: "Images the scripts run with `docker run`",
      customType: "regex",
      managerFilePatterns: ["/^scripts/.+\\.ts$/", "/(^|/)package\\.json$/"],
      matchStrings: [
        "(?:^|[\\s\"'])(?<depName>[a-z0-9][a-z0-9.-]*(?:/[a-z0-9][a-z0-9._-]*)+):(?<currentValue>v?\\d[\\w.-]*)[\\s\"']",
      ],
      datasourceTemplate: "docker",
    },
    {
      description: "Images in the charts' values and the local manifests, each pinned by digest too (scripts/dockerfiles.test.ts)",
      customType: "regex",
      managerFilePatterns: ["/^deploy/.+\\.ya?ml$/"],
      matchStrings: [
        "(?:image|imageName|imageRef): [\"']?(?<depName>[a-z0-9][a-z0-9.-]*(?:/[a-z0-9][a-z0-9._-]*)+):(?<currentValue>\\w[\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?\\s",
      ],
      datasourceTemplate: "docker",
    },
    {
      description: "The CRD schema catalog kubeconform reads (scripts/charts.ts), at a commit of its main branch",
      customType: "regex",
      managerFilePatterns: ["/^scripts/charts\\.ts$/"],
      matchStrings: ["datreeio/CRDs-catalog/(?<currentDigest>[0-9a-f]{40})/"],
      depNameTemplate: "datreeio/CRDs-catalog",
      packageNameTemplate: "https://github.com/datreeio/CRDs-catalog",
      currentValueTemplate: "main",
      datasourceTemplate: "git-refs",
    },
    {
      description: "Platform add-on charts from Helm repositories (deploy/platform/addons)",
      customType: "regex",
      managerFilePatterns: ["/^deploy/platform/addons/.+\\.yaml$/"],
      matchStrings: [
        "repoURL: (?<registryUrl>https://\\S+)\\nchart: (?<depName>\\S+)\\nversion: (?<currentValue>\\S+)",
      ],
      datasourceTemplate: "helm",
    },
    {
      description: "Platform add-on charts from OCI registries (deploy/platform/addons)",
      customType: "regex",
      managerFilePatterns: ["/^deploy/platform/addons/.+\\.yaml$/"],
      matchStrings: [
        "repoURL: (?<packageName>[a-z0-9][^\\s:]*)\\nchart: (?<depName>\\S+)\\nversion: (?<currentValue>\\S+)",
      ],
      packageNameTemplate: "{{{packageName}}}/{{{depName}}}",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      description: "Catalog updates raise the range and refresh bun.lock, as the Bun manager does for the rest",
      matchManagers: ["custom.regex"],
      matchFileNames: ["package.json"],
      rangeStrategy: "bump",
      postUpgradeTasks: {
        commands: ["bun install"],
        fileFilters: ["bun.lock"],
        executionMode: "branch",
        installTools: { bun: {} },
      },
    },
    {
      description: "The devcontainer's tool options are plain versions of v-prefixed tags",
      matchFileNames: [".devcontainer/devcontainer.json"],
      matchDatasources: ["github-releases"],
      extractVersion: "^v(?<version>.+)$",
    },
    {
      description: "OpenTofu: CI's and the devcontainer's",
      matchPackageNames: ["opentofu", "opentofu/opentofu", "ghcr.io/opentofu/opentofu"],
      groupName: "opentofu",
    },
    {
      description: "OpenTofu's required_version is a floor we raise on purpose, not a Terraform release",
      matchDepTypes: ["required_version"],
      enabled: false,
    },
    {
      description: "Bun: the package manager, the image builds and its types move together",
      matchPackageNames: ["bun", "oven/bun", "@types/bun"],
      groupName: "bun",
    },
    {
      description: "Playwright: the packages and the image packages/ui's visual tests run them in (its test:visual, scripts/docker-clean.ts) move together, since the screenshot baselines depend on the exact browser build (scripts/pins.test.ts); the official skills for Claude Code committed in .claude/skills are reinstalled from the new version (scripts/playwright.test.ts runs these commands too)",
      matchPackageNames: ["@playwright/test", "playwright", "playwright-core", "mcr.microsoft.com/playwright"],
      groupName: "playwright",
      postUpgradeTasks: {
        commands: ["bun install", "rm -rf .claude/skills/playwright-*", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 .claude/bin/playwright-cli install --skills", "bunx playwright trace install-skill"],
        fileFilters: [".claude/skills/playwright-*/**"],
        executionMode: "branch",
        installTools: { bun: {}, node: {} },
      },
    },
    {
      description: "Node: .nvmrc (CI and local development) and EAS's builds",
      matchPackageNames: ["node"],
      groupName: "node",
    },
    {
      description: "uv: CI's (the setup action) and the devcontainer's",
      matchPackageNames: ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      groupName: "uv",
    },
    {
      description: "Python: the local version, the image and the lockfile's",
      matchPackageNames: ["python"],
      groupName: "python",
    },
    {
      description: "Kubernetes: k3s on the clusters, kind's node image and the dev container's kubectl stay on one minor version (scripts/charts.test.ts)",
      matchPackageNames: ["k3s-io/k3s", "kindest/node", "kubernetes/kubernetes"],
      groupName: "kubernetes",
    },
    {
      description: "Envoy Gateway and the Envoy proxy image it defaults to, which the platform config chart names (deploy/platform/config/values.yaml): one version pair",
      matchPackageNames: ["gateway-helm", "registry-1.docker.io/envoyproxy/gateway-helm", "docker.io/envoyproxy/envoy"],
      groupName: "envoy-gateway",
    },
    {
      description: "Trivy: the image scan and the configuration scan",
      matchPackageNames: ["aquasec/trivy", "aquasecurity/trivy"],
      groupName: "trivy",
    },
    {
      description: "OSV-Scanner: the Security workflow's action and the pre-commit hook's image",
      matchPackageNames: ["google/osv-scanner-action", "ghcr.io/google/osv-scanner"],
      groupName: "osv-scanner",
    },
    {
      description: "Helm: the CLI in CI and its unittest plugin",
      matchPackageNames: ["helm", "helm/helm", "helm-unittest/helm-unittest"],
      groupName: "helm",
    },
    {
      description: "The mobile app's React Native and React versions come from the Expo SDK: upgrade them together with `bunx expo install --fix`. React is pinned exactly (19.2.3, repo-wide in the catalog, so web matches) because Expo SDK 57 requires that version; it moves with the next SDK, not on its own",
      matchPackageNames: ["expo", "expo-*", "@expo/*", "react-native", "react-native-*", "react", "react-dom", "@types/react", "@types/react-dom"],
      groupName: "Expo SDK",
    },
    {
      description: "TypeScript 7 (the native compiler) has no JavaScript compiler API yet, which openapi-typescript, Next's type check and Storybook's docgen need (see packages/typescript-config/base.json)",
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      description: "BullMQ for Node and for Python run the same Lua scripts against the same queues, so they move together: a Node upgrade without the matching Python release can change a script the other side still calls",
      matchPackageNames: ["bullmq"],
      groupName: "bullmq",
    },
    {
      description: "OpenTelemetry's SDK, exporters and instrumentations are released in step",
      matchPackageNames: ["@opentelemetry/*", "opentelemetry-*"],
      groupName: "opentelemetry",
    },
    {
      description: "React Email's CLI and its preview server are released together",
      matchPackageNames: ["react-email", "@react-email/ui"],
      groupName: "react-email",
    },
    {
      description: "helm-unittest's download is checked against a pinned checksum",
      matchPackageNames: ["helm-unittest/helm-unittest"],
      prBodyNotes: ["Update `SHA256` in `.github/workflows/ci.yml` to the release's `helm-unittest-linux-amd64-<version>.tgz` line in `helm-unittest-checksum.sha` before merging."],
    },
    {
      description: "The devcontainer's downloads: plain versions of v-prefixed tags, each checked against pinned checksums",
      matchFileNames: [".devcontainer/Dockerfile"],
      matchDatasources: ["github-releases"],
      extractVersion: "^v(?<version>.+)$",
      prBodyNotes: ["Update the release's checksums for both architectures in `.devcontainer/Dockerfile` before merging."],
    },
    {
      description: "kind's download is checked against a pinned checksum",
      matchPackageNames: ["kubernetes-sigs/kind"],
      prBodyNotes: ["Update `SHA256` in `.github/workflows/kind.yml` to the release's `kind-linux-amd64.sha256sum` before merging."],
    },
    {
      description: "Postgres majors need a dump and restore (or pg_upgrade), never a tag bump",
      matchPackageNames: ["pgvector/pgvector", "ghcr.io/cloudnative-pg/postgresql", "docker.io/library/postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
