// Unused files, exports and dependencies, and dependencies used without being declared
// (`bun run lint:unused`, in CI's lint job). With Bun's hoisted install an undeclared
// dependency still resolves locally, then breaks in a pruned Docker image; this is what
// catches it. Knip finds most entry points through its plugins (Next, Nest via tsdown,
// Vitest, Playwright, Storybook, Expo, Jest, …); the ones below are started some other way.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Generated clients export more than we call; they're regenerated, not pruned. A
  // `.d.json.ts` types its JSON file for TypeScript, which nothing imports by name.
  "ignore": ["**/generated/**", "**/*.d.json.ts"],
  // A tool installed on the machine (doctor checks it), not an npm package.
  "ignoreBinaries": ["uv"],
  "workspaces": {
    ".": {
      // Claude Code hooks (.claude/settings.json), the image build's peer check
      // (deploy/docker/*.Dockerfile) and the repo scripts.
      "entry": [".claude/hooks/*.ts", "deploy/docker/check-peers.mjs", "scripts/*.ts"],
      // Run through bunx by scripts/type-coverage.ts and scripts/pre-commit.ts, which knip
      // doesn't read as commands; playwright-core by .claude/bin/playwright-cli, which
      // knip doesn't read.
      "ignoreDependencies": ["type-coverage", "lint-staged", "playwright-core"]
    },
    "apps/api": {
      // The better-auth CLI's config (the auth:schema script).
      "entry": ["src/auth/auth.cli.ts"]
    },
    // The telemetry bootstrap, a build entry of the shared tsdown preset (loaded with
    // `node --import`), which knip doesn't read.
    "apps/worker": { "entry": ["src/main.ts", "src/telemetry.ts"] },
    "apps/notifications": { "entry": ["src/main.ts", "src/telemetry.ts"] },
    "apps/webhooks": { "entry": ["src/main.ts", "src/telemetry.ts"] },
    "apps/ai": {
      // The Python service; its package.json only runs uv. @repo/jobs orders codegen:
      // `gen` reads packages/jobs/generated for the queue contracts.
      "ignoreDependencies": ["@repo/jobs"]
    },
    "apps/web": {
      // The push service worker, served as a static file.
      "entry": ["public/sw.js"]
    },
    "apps/mobile": {
      // Run by Maestro flows (runScript).
      "entry": ["maestro/scripts/*.js"]
    },
    "load": {
      // The k6 script, run in the k6 image, which provides the k6/* modules.
      "entry": ["api.ts"],
      "ignoreDependencies": ["k6"]
    },
    // A package's exports are its API to the rest of the repo: one nothing imports is
    // dead, so knip reports it too (includeEntryExports) instead of trusting the entry.
    // The glob covers the packages without settings of their own; each package listed
    // below sets it again, since a workspace's own entry replaces the glob's.
    "packages/*": { "includeEntryExports": true },
    "packages/ai-client": {
      "includeEntryExports": true,
      // Orders codegen: the client is generated from apps/ai's openapi.json.
      "ignoreDependencies": ["@repo/ai"]
    },
    "packages/db": {
      "includeEntryExports": true,
      // Imported by the generated Prisma client (src/generated, not committed).
      "ignoreDependencies": ["@prisma/client"]
    },
    "packages/logger": {
      "includeEntryExports": true,
      // Loaded by name as pino's development transport.
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/nest-common": {
      "includeEntryExports": true,
      // Run as a child `node --import …` process by test/telemetry.integration.test.ts.
      "entry": ["test/fixtures/*.mjs"]
    },
    "packages/typescript-config": {
      "includeEntryExports": true,
      // The Next.js TypeScript plugin, named in nextjs.json.
      "ignoreUnresolved": ["next"]
    },
    "packages/ui": {
      // The components are shadcn's, kept whole (overlays, portals, scroll buttons and
      // variants included) so `shadcn add --overwrite` can update them from upstream.
      "includeEntryExports": false,
      // The visual regression run (test:visual, in the Playwright image).
      "entry": ["visual/playwright.config.ts", "visual/serve.mjs"]
    }
  }
}
