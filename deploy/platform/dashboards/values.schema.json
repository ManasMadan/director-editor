{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dashboards chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "jaegerUid": { "type": "string", "minLength": 1 },
