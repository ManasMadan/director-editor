{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "jaeger chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "image": { "type": "string", "minLength": 1 },
    "maxTraces": { "type": "integer", "minimum": 1000 },
    "domain": { "type": "string" },
    "directZone": { "type": "string" },
    "grafanaUrl": { "type": "string" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": "string" } },
        "limits": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
