{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "internal-tools chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "domain": { "$ref": "#/$defs/hostOrEmpty" },
    "directZone": { "$ref": "#/$defs/hostOrEmpty" },
    "observability": { "type": ["string", "boolean"] },
    "gateway": { "type": "string", "minLength": 1 },
    "basicAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName"],
      "properties": { "secretName": { "type": "string", "minLength": 1 } }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "service"],
        "properties": {
          "enabled": { "type": "boolean" },
          "host": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
          "observability": { "type": "boolean" },
          "openPaths": {
            "type": "array",
            "items": { "type": "string", "pattern": "^/" }
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "name", "port"],
            "properties": {
              "namespace": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hostOrEmpty": { "type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" }
  }
}
