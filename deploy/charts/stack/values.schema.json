{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "stack chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "site", "services"],
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "tag"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string" } }
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "host": { "type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
        "scheme": { "enum": ["https", "http"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egressNamespaces", "privateRanges", "privateRangesV6"],
      "properties": {
        "egressNamespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "privateRanges": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9.]+/[0-9]+$" }
        },
        "privateRangesV6": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f:]+/[0-9]+$" }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" }
            }
          }
        },
        "namespaceSelector": { "$ref": "#/$defs/stringMap" }
      }
    },
    "env": { "$ref": "#/$defs/env" },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "otlpEndpoint": { "type": "string", "pattern": "^https?://" },
        "metricsEndpoint": { "type": "string", "pattern": "^https?://" },
        "alertmanagerUrl": { "type": "string", "pattern": "^https?://" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretPrefix": { "type": "string" },
        "caSecret": { "type": "string" }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "secretName": { "type": "string", "minLength": 1 } }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "secretName": { "type": "string", "minLength": 1 } }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30 },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "reencrypt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,20}$" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30 },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "defaults": { "$ref": "#/$defs/service" },
    "services": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,20}$" },
      "additionalProperties": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "env": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/$defs/stringMap" },
        "limits": { "$ref": "#/$defs/stringMap" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "imageRef": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tcpProbe": { "type": "boolean" },
        "livenessCommand": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveness", "readiness"],
          "properties": {
            "liveness": { "type": "string", "pattern": "^/" },
            "readiness": { "type": "string", "pattern": "^/" }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "match": { "enum": ["PathPrefix", "Exact"] },
              "timeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "envPrefix"],
          "properties": {
            "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "envPrefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "directUrl": { "type": "boolean" }
          }
        },
        "redis": { "type": "boolean" },
        "storage": { "enum": ["presign", "internal", "origin", "none"] },
        "secretFrom": { "type": "string" },
        "env": { "$ref": "#/$defs/env" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/$defs/resources" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "nodeSelector": { "$ref": "#/$defs/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "podAnnotations": { "$ref": "#/$defs/stringMap" },
        "topologySpread": { "type": "boolean" },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "type": ["integer", "string"] }
          }
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "keda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 0 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "listLength": { "type": "integer", "minimum": 1 },
            "queues": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            }
          }
        },
        "allowFrom": { "type": "array", "items": { "type": "string" } },
        "allowFromNamespaces": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" }
        },
        "writablePaths": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
        "caBundle": { "type": "string" }
      }
    }
  }
}
