/**
 * The organization's {{lowerCase (sentenceCase name)}}, newest first, loaded page by page.
 *
 *   const {{camelCase name}} = use{{pascalCase name}}ListInfiniteQuery();
 *   {{camelCase name}}.data?.pages.flatMap((page) => page.items)
 *   {{camelCase name}}.fetchNextPage()   // when {{camelCase name}}.hasNextPage
 */
import { useInfiniteQuery } from "@tanstack/react-query";
import { useApi } from "../../provider";

const {{constantCase name}}_PAGE_SIZE = 20;

/**
 * @public until a screen calls it (knip reports an export nothing imports); take the tag
 * out in the change that does.
 */
export function use{{pascalCase name}}ListInfiniteQuery(limit = {{constantCase name}}_PAGE_SIZE) {
  const { api } = useApi();
  return useInfiniteQuery(
    api.{{camelCase name}}.list.infiniteOptions({
      input: (cursor: string | undefined) => ({ limit, ...(cursor && { cursor }) }),
      initialPageParam: undefined,
      getNextPageParam: (last) => last.nextCursor ?? undefined,
    }),
  );
}
