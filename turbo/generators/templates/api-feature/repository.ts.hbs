/**
 * Data access for {{lowerCase (sentenceCase name)}}. The only place that knows how they are stored.
 * Every query runs through withTenant/tenantTx, so row-level security scopes it to the
 * caller's organization even if a where clause is forgotten.
 */
import { Injectable } from "@nestjs/common";
import type { OrgId } from "@repo/contracts/ids";
import type { PageInput } from "@repo/contracts/pagination";
import { type Tx, withTenant } from "@repo/db";
import { type Database, InjectDatabase } from "@repo/nest-common";

const columns = { id: true, createdAt: true } as const;

@Injectable()
export class {{pascalCase name}}Repository {
  constructor(@InjectDatabase() private readonly database: Database) {}

  /** Newest first, `limit + 1` rows so the caller can tell whether another page exists. */
  list(orgId: OrgId, { limit, cursor }: PageInput) {
    return withTenant(this.database.read, orgId).{{model}}.findMany({
      where: cursor ? { id: { lt: cursor } } : {},
      orderBy: { id: "desc" },
      take: limit + 1,
      select: columns,
    });
  }

  /** Whether there was one to delete (in the transaction's organization). */
  async delete(tx: Tx, id: string) {
    const { count } = await tx.{{model}}.deleteMany({ where: { id } });
    return count > 0;
  }
}
