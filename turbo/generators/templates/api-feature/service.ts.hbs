/**
 * {{sentenceCase name}} business rules. Write each change and its domain event in one
 * tenantTx (see todo.service.ts), so the audit log, webhooks and notifications never
 * miss or invent one.
 */
import { Injectable } from "@nestjs/common";
import type { OrgId } from "@repo/contracts/ids";
import { type PageInput, toPage } from "@repo/contracts/pagination";
import { tenantTx } from "@repo/db";
import { AppError, type Database, InjectDatabase } from "@repo/nest-common";
import { emitEvent } from "../../outbox";
import { {{pascalCase name}}Repository } from "./{{kebabCase name}}.repository";

@Injectable()
export class {{pascalCase name}}Service {
  constructor(
    @InjectDatabase() private readonly database: Database,
    private readonly repository: {{pascalCase name}}Repository,
  ) {}

  async list(orgId: OrgId, page: PageInput) {
    return toPage(await this.repository.list(orgId, page), page.limit);
  }

  async delete(orgId: OrgId, id: string) {
    await tenantTx(this.database.write, orgId, async (tx) => {
      if (!(await this.repository.delete(tx, id))) {
        throw new AppError("NOT_FOUND");
      }
      await emitEvent(tx, "{{snakeCase item}}.deleted.v1", id, { {{camelCase item}}Id: id });
    });
  }
}
