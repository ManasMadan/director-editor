{
  "name": "@repo/nest-common",
  "private": true,
  "type": "module",
  "description": "Framework plumbing shared by every NestJS service. Never put domain logic here.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./telemetry": "./src/telemetry.ts"
  },
  "scripts": {
    "check-types": "tsc",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --tags-filter=!files",
    "test:integration:files": "vitest run --project integration --tags-filter=files",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/under-pressure": "^9.2.0",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/terminus": "^12",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-ioredis": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-pino": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/logger": "workspace:*",
    "bullmq": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "ipaddr.js": "^2.5.0",
    "nestjs-pino": "^5.2.1",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.8",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "undici": "^8.11.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/proxy-addr": "^2.0.3",
    "pg": "^8.23.0",
    "pino": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
