{
  "name": "@repo/fake-stripe",
  "private": true,
  "type": "module",
  "description": "A stateful local stand-in for the parts of Stripe the app uses, for tests and offline development.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun --env-file=../../.env src/main.ts",
    "check-types": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
