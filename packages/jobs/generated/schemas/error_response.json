{
  "title": "ErrorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "defined": {
      "type": "boolean"
    },
    "code": {
      "type": "string",
      "enum": [
        "BAD_REQUEST",
        "VALIDATION_FAILED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "CONFLICT",
        "RATE_LIMITED",
        "INTERNAL",
        "SERVICE_UNAVAILABLE",
        "METHOD_NOT_SUPPORTED",
        "TIMEOUT",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_MEDIA_TYPE",
        "IDEMPOTENCY_IN_PROGRESS",
        "FEATURE_DISABLED",
        "CLIENT_OUTDATED",
        "FRESH_SESSION_REQUIRED",
        "DESTINATION_NOT_ALLOWED",
        "RESPONSE_TOO_LARGE",
        "TOO_MANY_REDIRECTS",
        "UPSTREAM_UNAVAILABLE",
        "NO_ACTIVE_ORGANIZATION",
        "DEMO_ACCOUNT_LOCKED",
        "FILE_NOT_FOUND",
        "FILE_TYPE_NOT_ALLOWED",
        "FILE_TOO_LARGE",
        "FILE_SIZE_MISMATCH",
        "FILE_INFECTED",
        "FILE_UNREADABLE",
        "FILE_NOT_UPLOADED",
        "FILE_NOT_READY",
        "INVALID_SIGNATURE",
        "AI_BUDGET_EXCEEDED",
        "DIRECTOR_INDEX_LIMIT",
        "DIRECTOR_VIDEO_UNAVAILABLE",
        "DIRECTOR_TOO_LONG",
        "DIRECTOR_PLAN_NOT_FOUND",
        "DIRECTOR_PLAN_NOT_READY",
        "DIRECTOR_SHOT_NOT_FOUND",
        "DIRECTOR_TAKE_NOT_FOUND",
        "DIRECTOR_TAKE_KIND_MISMATCH",
        "DIRECTOR_CALL_TOO_FAST",
        "DIRECTOR_CUT_NOT_FOUND",
        "PUBLISH_DEMO_DISABLED",
        "PUBLISH_NEEDS_YOUTUBE",
        "PUBLISH_CUT_NOT_READY",
        "PUBLISH_NO_CHANNEL",
        "PUBLISH_QUOTA_EXHAUSTED",
        "DIRECTOR_VIDEO_UNREADABLE",
        "DIRECTOR_ANALYSIS_FAILED",
        "DIRECTOR_REVIEW_FAILED"
      ],
      "title": "ErrorCode"
    },
    "status": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "params": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "requestId": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "code": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "code"
            ],
            "additionalProperties": false,
            "title": "ErrorIssue"
          }
        }
      },
      "required": [
        "params"
      ],
      "additionalProperties": false,
      "title": "ErrorData"
    }
  },
  "required": [
    "defined",
    "code",
    "status",
    "message",
    "data"
  ],
  "additionalProperties": false
}
