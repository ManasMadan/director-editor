{
  "title": "QueueSetting",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prefix": {
      "type": "string"
    },
    "options": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer"
        },
        "backoff": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "delay": {
              "type": "integer"
            },
            "jitter": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "title": "Backoff"
        },
        "removeOnComplete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "object",
              "properties": {
                "age": {
                  "type": "integer"
                },
                "count": {
                  "type": "integer"
                }
              },
              "additionalProperties": false,
              "title": "KeepJobs"
            }
          ]
        },
        "removeOnFail": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "object",
              "properties": {
                "age": {
                  "type": "integer"
                },
                "count": {
                  "type": "integer"
                }
              },
              "additionalProperties": false,
              "title": "KeepJobs"
            }
          ]
        }
      },
      "required": [
        "attempts",
        "backoff",
        "removeOnComplete",
        "removeOnFail"
      ],
      "additionalProperties": false,
      "title": "JobOptions"
    }
  },
  "required": [
    "prefix",
    "options"
  ],
  "additionalProperties": false
}
