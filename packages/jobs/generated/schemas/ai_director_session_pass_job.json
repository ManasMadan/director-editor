          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "orgId": {
          "type": "string"
        }
      }
    },
    "payload": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "orgId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
