{
  "name": "@repo/ui",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./theme.css": "./src/styles/theme.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "check-types": "tsc",
    "test:stories": "vitest run",
    "storybook": "bun --env-file=../../.env run sh -c 'exec storybook dev -p \"$STORYBOOK_PORT\" --no-open'",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "turbo run build-storybook --filter=@repo/ui --output-logs=new-only && docker run --rm --ipc=host --memory=1536m -v \"$(git rev-parse --show-toplevel)\":/work -w /work/packages/ui mcr.microsoft.com/playwright:v1.63.0-noble node /work/node_modules/@playwright/test/cli.js test -c visual/playwright.config.ts",
    "test:visual:update": "turbo run build-storybook --filter=@repo/ui --output-logs=new-only && docker run --rm --ipc=host --memory=1536m -v \"$(git rev-parse --show-toplevel)\":/work -w /work/packages/ui mcr.microsoft.com/playwright:v1.63.0-noble node /work/node_modules/@playwright/test/cli.js test -c visual/playwright.config.ts --update-snapshots",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "playwright": "1.63.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vitest": "catalog:"
  }
}
