// Owner: apps/api. A mirror of what Stripe knows about each organization's billing:
// Stripe is the source of truth, and every subscription event re-reads the subscription
// from Stripe and overwrites the row, so the order events arrive in doesn't matter.
// Tenant tables: read and written with app.org_id set (row-level security).

/// The organization's Stripe customer, created the first time an admin starts checkout.
model BillingCustomer {
  orgId            String       @id @map("org_id") @db.Uuid
  stripeCustomerId String       @unique @map("stripe_customer_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("customer")
  @@schema("billing")
}

/// A Stripe subscription (current state). An organization has at most one that isn't
/// ended; ended ones are kept as history.
model Subscription {
  /// Stripe's subscription id (sub_...).
  id                String       @id
  orgId             String       @map("org_id") @db.Uuid
  /// packages/contracts billing `planNames`.
  plan              String
  /// Stripe's status: trialing | active | past_due | unpaid | canceled | incomplete | ...
  status            String
  priceId           String       @map("price_id")
  /// month | year
  interval          String
  /// Seats billed for.
  quantity          Int
  currentPeriodEnd  DateTime     @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean      @default(false) @map("cancel_at_period_end")
  trialEnd          DateTime?    @map("trial_end") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("subscription")
  @@schema("billing")
}

/// A card that has had a free trial, by its Stripe fingerprint (a card has the same one in
/// every Stripe customer). The first subscription to use it keeps its trial; any other has
/// its trial ended at once, so new workspaces can't farm trials with one card. Not a tenant
/// table: the check has to see every workspace's cards, and a row holds only Stripe's ids.
model TrialCard {
  fingerprint    String   @id
  /// Stripe's id of the subscription that had the trial (sub_...).
  subscriptionId String   @map("subscription_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("trial_card")
  @@schema("billing")
}
