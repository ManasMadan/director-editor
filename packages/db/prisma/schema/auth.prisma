// Owner: apps/api (better-auth). Model and field names are exactly what better-auth
// expects (they come from `bun run --filter @repo/api auth:schema`, which prints the
// schema for the current plugin set); columns, types and ids follow this repo's
// conventions. After adding or removing a better-auth plugin, regenerate and port the
// differences here (db-change skill).
//
// Published read-only to other services: auth.user identity columns (name, email,
// locale, timezone) for the notification service.

model User {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false) @map("email_verified")
  image                   String?
  /// BCP 47 language tag from packages/i18n `locales`; drives every email, push and SMS.
  locale                  String                   @default("en")
  /// IANA time zone, used to format dates in notifications and to respect quiet hours.
  timezone                String                   @default("UTC")
  twoFactorEnabled        Boolean                  @default(false) @map("two_factor_enabled")
  /// E.164, and only ever a number the user verified with a texted code (apps/api phone module).
  /// Not generated by better-auth: keep when regenerating.
  phoneNumber             String?                  @unique @map("phone_number")
  // admin plugin
  role                    String?
  banned                  Boolean                  @default(false)
  banReason               String?                  @map("ban_reason")
  banExpires              DateTime?                @map("ban_expires") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                Session[]
  accounts                Account[]
  twoFactors              TwoFactor[]
  passkeys                Passkey[]
  members                 Member[]
  /// App data this user created (app schema). Not generated by better-auth: keep when regenerating.
  todos                   Todo[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationSettings    NotificationSettings?
  notificationDigestItems NotificationDigestItem[]
  notificationDevices     NotificationDevice[]
  files                   File[]
  aiDocuments             Document[]
  invitations             Invitation[]
  oauthClients            OauthClient[]
  oauthRefreshTokens      OauthRefreshToken[]
  oauthAccessTokens       OauthAccessToken[]
  oauthConsents           OauthConsent[]

  @@map("user")
  @@schema("auth")
}

model Session {
  id                   String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token                String               @unique
  userId               String               @map("user_id") @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(3)
  ipAddress            String?              @map("ip_address")
  userAgent            String?              @map("user_agent")
  // organization plugin: the organization this session is working in.
  activeOrganizationId String?              @map("active_organization_id") @db.Uuid
  // admin plugin: set while an admin impersonates this user.
  impersonatedBy       String?              @map("impersonated_by") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  notificationDevices  NotificationDevice[]
  oauthRefreshTokens   OauthRefreshToken[]
  oauthAccessTokens    OauthAccessToken[]

  @@index([userId])
  @@map("session")
  @@schema("auth")
}

model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Encrypted at rest by better-auth (account.encryptOAuthTokens).
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash (scrypt) for email + password accounts.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
  @@schema("auth")
}

model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  /// Hashed one-time codes (emailOTP storeOTP: "hashed").
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
  @@schema("auth")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([userId])
  @@map("two_factor")
  @@schema("auth")
}

model Passkey {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String?
  publicKey    String    @map("public_key")
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @unique @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("passkey")
  @@schema("auth")
}

model Organization {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  slug               String              @unique
  logo               String?
  metadata           String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  members            Member[]
  /// Tenant data (app and webhooks schemas). Not generated by better-auth: keep when regenerating.
  todos              Todo[]
  webhookEndpoints   WebhookEndpoint[]
  billingCustomer    BillingCustomer?
  aiDocuments        Document[]
  aiUsage            AiUsage[]
  subscriptions      Subscription[]
  invitations        Invitation[]
  /// MCP grants approved for this workspace (oauth-provider's reference id).
  oauthConsents      OauthConsent[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  /// The workspace's API keys (the api-key plugin's reference id).
  apiKeys            Apikey[]

  @@map("organization")
  @@schema("auth")
}

model Member {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner | admin | member (organization plugin access control).
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
  @@schema("auth")
}

model Invitation {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  /// pending | accepted | rejected | canceled
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  inviterId      String       @map("inviter_id") @db.Uuid
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
  @@schema("auth")
}

model Apikey {
  id                  String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  configId            String       @default("default") @map("config_id")
  name                String?
  /// First characters of the key, shown in the UI to recognise it.
  start               String?
  prefix              String?
  /// Hash of the key; the plaintext key is only shown once, at creation.
  key                 String       @unique
  /// The organization that owns the key (the plugin's `references: "organization"`).
  referenceId         String       @map("reference_id") @db.Uuid
  organization        Organization @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  refillInterval      Int?         @map("refill_interval")
  refillAmount        Int?         @map("refill_amount")
  lastRefillAt        DateTime?    @map("last_refill_at") @db.Timestamptz(3)
  enabled             Boolean      @default(true)
  rateLimitEnabled    Boolean      @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int          @default(86400000) @map("rate_limit_time_window")
  rateLimitMax        Int          @default(10) @map("rate_limit_max")
  requestCount        Int          @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime?    @map("last_request") @db.Timestamptz(3)
  expiresAt           DateTime?    @map("expires_at") @db.Timestamptz(3)
  permissions         String?
  metadata            String?
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([referenceId])
  @@map("api_key")
  @@schema("auth")
}

// jwt plugin: keys that sign OAuth access tokens, published at /api/auth/jwks. The
// private key is encrypted with BETTER_AUTH_SECRET.
model Jwks {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  alg        String?
  crv        String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)

  @@map("jwks")
  @@schema("auth")
}

// mcp / oauth-provider plugins: the OAuth 2.1 authorization server for MCP clients.
// `referenceId` on consents and tokens is the workspace the user approved (see auth.ts),
// so it references auth.organization and goes with it.

/// A registered OAuth client: self-registered (RFC 7591) or discovered from its
/// metadata URL (Client ID Metadata Documents, where the client id is that URL).
model OauthClient {
  id                               String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId                         String                @unique @map("client_id")
  /// Hash of the secret (confidential clients only).
  clientSecret                     String?               @map("client_secret")
  clientDiscoveryId                String?               @map("client_discovery_id")
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?              @map("skip_consent")
  enableEndSession                 Boolean?              @map("enable_end_session")
  subjectType                      String?               @map("subject_type")
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([]) @map("client_credentials_scopes")
  userId                           String?               @map("user_id") @db.Uuid
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?               @map("software_id")
  softwareVersion                  String?               @map("software_version")
  softwareStatement                String?               @map("software_statement")
  redirectUris                     String[]              @map("redirect_uris")
  postLogoutRedirectUris           String[]              @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?               @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?              @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?               @map("token_endpoint_auth_method")
  applicationType                  String?               @map("application_type")
  jwks                             String?
  jwksUri                          String?               @map("jwks_uri")
  grantTypes                       String[]              @map("grant_types")
  responseTypes                    String[]              @map("response_types")
  requirePKCE                      Boolean?              @map("require_pkce")
  dpopBoundAccessTokens            Boolean?              @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?               @map("reference_id")
  metadata                         Json?
  createdAt                        DateTime?             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(3)
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
  @@schema("auth")
}

/// A protected resource (an MCP server) tokens can be issued for. Seeded from auth.ts
/// on every boot.
model OauthResource {
  id                            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?                  @map("access_token_ttl")
  refreshTokenTtl               Int?                  @map("refresh_token_ttl")
  signingAlgorithm              String?               @map("signing_algorithm")
  signingKeyId                  String?               @map("signing_key_id")
  allowedScopes                 String[]              @map("allowed_scopes")
  customClaims                  Json?                 @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?              @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?              @default(false)
  policyVersion                 Int?                  @default(1) @map("policy_version")
  metadata                      Json?
  createdAt                     DateTime?             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime?             @updatedAt @map("updated_at") @db.Timestamptz(3)
  clients                       OauthClientResource[]

  @@map("oauth_resource")
  @@schema("auth")
}

model OauthClientResource {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId   String        @map("client_id")
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String        @map("resource_id")
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([clientId, resourceId])
  @@index([resourceId])
  @@map("oauth_client_resource")
  @@schema("auth")
}

model OauthRefreshToken {
  id                      String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Hash of the token.
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id") @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String             @map("user_id") @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id") @db.Uuid
  organization            Organization?      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @map("requested_user_info_claims")
  scopes                  String[]
  expiresAt               DateTime           @map("expires_at") @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  revoked                 DateTime?          @db.Timestamptz(3)
  rotatedAt               DateTime?          @map("rotated_at") @db.Timestamptz(3)
  rotationReplayResponse  String?            @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime?          @map("rotation_replay_expires_at") @db.Timestamptz(3)
  authTime                DateTime?          @map("auth_time") @db.Timestamptz(3)
  confirmation            Json?
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([referenceId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
  @@schema("auth")
}

/// Issued access tokens (JWTs are verified by signature; this is the record of issue).
model OauthAccessToken {
  id                      String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id") @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @map("user_id") @db.Uuid
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id") @db.Uuid
  organization            Organization?      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @map("requested_user_info_claims")
  refreshId               String?            @map("refresh_id") @db.Uuid
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  scopes                  String[]
  expiresAt               DateTime           @map("expires_at") @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  revoked                 DateTime?          @db.Timestamptz(3)
  confirmation            Json?

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([referenceId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
  @@schema("auth")
}

/// What a user approved for a client, in one workspace (the reference).
model OauthConsent {
  id                      String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId                String        @map("client_id")
  client                  OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?       @map("user_id") @db.Uuid
  user                    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?       @map("reference_id") @db.Uuid
  organization            Organization? @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  resources               String[]
  requestedUserInfoClaims String[]      @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([clientId])
  @@index([userId])
  @@index([referenceId])
  @@map("oauth_consent")
  @@schema("auth")
}

/// Client assertion ids already used (private_key_jwt replay protection).
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("oauth_client_assertion")
  @@schema("auth")
}
