// Owner: apps/webhooks (deliveries, inbound provider events, its outbox), with one
// shared table: `endpoint` is organization configuration that apps/api edits for org
// admins. The webhooks service only reads it, apart from marking an endpoint disabled
// when it keeps failing (column-level grant). Endpoints and deliveries are tenant
// tables: every role, including the webhooks service, reads them through row-level
// security with app.org_id set.

/// A customer's HTTPS endpoint that receives events for their organization.
model WebhookEndpoint {
  id                      String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                   String            @map("org_id") @db.Uuid
  url                     String
  description             String            @default("")
  /// Subscribed event names (packages/contracts webhookEvents); empty means all of them.
  events                  String[]
  /// Signing secret (whsec_...), encrypted with ENCRYPTION_KEYS; shown to the admin once.
  secret                  String
  /// The secret before the last rotation, still signed with until the expiry below so
  /// receivers can switch without dropping deliveries. Encrypted like `secret`.
  previousSecret          String?           @map("previous_secret")
  previousSecretExpiresAt DateTime?         @map("previous_secret_expires_at") @db.Timestamptz(3)
  createdById             String?           @map("created_by_id") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by an admin ("manual") or by the delivery service ("failing").
  disabledAt              DateTime?         @map("disabled_at") @db.Timestamptz(3)
  disabledReason          String?           @map("disabled_reason")
  organization            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries              WebhookDelivery[]

  @@index([orgId])
  @@map("endpoint")
  @@schema("webhooks")
}

/// One event sent (or being sent) to one endpoint, with the outcome of the latest try.
model WebhookDelivery {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  endpointId     String          @map("endpoint_id") @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  eventName      String          @map("event_name")
  /// The exact JSON body that is signed and sent on every attempt.
  body           String
  /// pending → succeeded | failed (retries exhausted)
  status         String          @default("pending")
  attempts       Int             @default(0)
  lastAttemptAt  DateTime?       @map("last_attempt_at") @db.Timestamptz(3)
  lastStatus     Int?            @map("last_status")
  lastError      String?         @map("last_error")
  lastDurationMs Int?            @map("last_duration_ms")
  succeededAt    DateTime?       @map("succeeded_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  /// One delivery per event per endpoint, however often the event is redelivered to us.
  @@unique([endpointId, eventId])
  @@index([endpointId, id(sort: Desc)])
  @@index([orgId])
  @@map("delivery")
  @@schema("webhooks")
}

/// A verified event received from a provider (Stripe), stored once by its provider id.
model WebhookInboundEvent {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  type            String
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@map("inbound_event")
  @@schema("webhooks")
}

/// The webhooks service's outbox (same shape as app.outbox_event; see app.prisma).
model WebhooksOutboxEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  key         String
  payload     Json
  orgId       String?   @map("org_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  requestId   String?   @map("request_id")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([occurredAt], map: "webhooks_outbox_event_unpublished_idx", where: raw("published_at IS NULL"))
  @@map("outbox_event")
  @@schema("webhooks")
}

/// Events the webhooks service has already handled.
model WebhooksProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@map("processed_event")
  @@schema("webhooks")
}
