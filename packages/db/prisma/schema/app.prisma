// Owner: apps/api. Product data. Tenant tables carry org_id and are protected by
// row-level security (policies live in the migration SQL).
//
// Every tenant table references auth.organization with ON DELETE CASCADE, so deleting
// an organization (or the account that solely owns it) removes its data in the same
// transaction. Postgres runs referential actions as the table owner, so RLS doesn't
// hide rows from the cascade. Rows a user created point at them with SET NULL: a
// member leaving doesn't delete the team's data.

/// Example tenant-owned model. Replace with your own; keep the org_id + RLS pattern.
model Todo {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  title       String   @db.VarChar(200)
  completed   Boolean  @default(false)
  /// Optimistic concurrency: updates must match the version they read.
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, id(sort: Desc)])
  @@index([createdById])
  @@map("todo")
  @@schema("app")
}

/// Domain events written in the same transaction as the change that caused them, then
/// relayed to queues by apps/worker (transactional outbox). Rows are kept for the
/// retention window so consumers can be replayed.
model AppOutboxEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Versioned event name from packages/contracts events, e.g. "todo.completed.v1".
  name        String
  /// Ordering/partition key for future brokers (usually the aggregate id).
  key         String
  payload     Json
  orgId       String?   @map("org_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  requestId   String?   @map("request_id")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  /// The relay only ever scans unpublished rows; published ones never enter this index.
  @@index([occurredAt], map: "outbox_event_unpublished_idx", where: raw("published_at IS NULL"))
  @@map("outbox_event")
  @@schema("app")
}

/// Events this service has already handled, so redelivered events are ignored.
model AppProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@map("processed_event")
  @@schema("app")
}
