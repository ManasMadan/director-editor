// Owner: apps/api. Product data. Tenant tables carry org_id and are protected by
// row-level security (policies live in the migration SQL).
//
// Every tenant table references auth.organization with ON DELETE CASCADE, so deleting
// an organization (or the account that solely owns it) removes its data in the same
// transaction. Postgres runs referential actions as the table owner, so RLS doesn't
// hide rows from the cascade. Rows a user created point at them with SET NULL: a
// member leaving doesn't delete the team's data.

/// Domain events written in the same transaction as the change that caused them, then
/// relayed to queues by apps/worker (transactional outbox). Rows are kept for the
/// retention window so consumers can be replayed.
model AppOutboxEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Versioned event name from packages/contracts events, e.g. "auth.signed_up.v1".
  name        String
  /// Ordering/partition key for future brokers (usually the aggregate id).
  key         String
  payload     Json
  orgId       String?   @map("org_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  requestId   String?   @map("request_id")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  /// The relay only ever scans unpublished rows; published ones never enter this index.
  @@index([occurredAt], map: "outbox_event_unpublished_idx", where: raw("published_at IS NULL"))
  @@map("outbox_event")
  @@schema("app")
}

/// Events this service has already handled, so redelivered events are ignored.
model AppProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@map("processed_event")
  @@schema("app")
}

/// A YouTube short a member liked or saved (the Shorts feed's like and save buttons).
model ShortReaction {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  /// The YouTube video id (11 characters).
  videoId      String       @map("video_id")
  /// like | save
  kind         String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, videoId, kind])
  @@index([orgId, id(sort: Desc)])
  @@index([userId])
  @@map("short_reaction")
  @@schema("app")
}

/// Director's continuous recording (the roll): one session per "Start shooting" on a
/// plan, until Done, the member's own. Its footage is in storage under
/// `recordings/<id>/<part>/<slice>`, in ten-second slices the browser uploads as it
/// records (packages/contracts recording.ts). Each attempt Director marks is cut out of
/// it as a take (ai.director_take) by the clipper; the raw footage is deleted at
/// `expires_at` (app.purge_expired_recordings, run by apps/worker's maintenance).
model RecordingSession {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  /// The plan's YouTube video id, for the takes cut from it.
  videoId      String             @map("video_id")
  /// How many shots the plan has (a ready plan's shots never change): what a mark may name.
  shotCount    Int                @map("shot_count")
  /// recording | done
  status       String             @default("recording")
  /// Recorded on the shared demo account, whose footage and takes go after 24 hours.
  demo         Boolean            @default(false)
  /// Footage uploaded so far: what counts against the 20 minutes and the member's allowance.
  recordedMs   Int                @default(0) @map("recorded_ms")
  bytes        Int                @default(0)
  /// When its raw footage is deleted: 7 days after the last video saved from it, 14 days
  /// at most; 24 hours for the demo.
  expiresAt    DateTime           @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt   DateTime?          @map("finished_at") @db.Timestamptz(3)
  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         DirectorPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  parts        RecordingPart[]
  attempts     RecordingAttempt[]
  pauses       RecordingPause[]

  @@index([orgId, userId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([planId])
  @@index([expiresAt])
  @@map("recording_session")
  @@schema("app")
}

/// One run of the browser's recorder in a session: the first, and one per camera flip or
/// comeback (a recorder can't switch tracks). Its slices are played from the first.
model RecordingPart {
  sessionId   String             @map("session_id") @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  index       Int
  /// front | back
  camera      String
  /// video/webm | video/mp4: what the recorder made.
  contentType String             @map("content_type")
  /// How many slices the run made, once its recorder stopped (null while it records).
  sliceCount  Int?               @map("slice_count")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  session     RecordingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  slices      RecordingSlice[]
  attempts    RecordingAttempt[]
  pauses      RecordingPause[]

  @@id([sessionId, index])
  @@map("recording_part")
  @@schema("app")
}

/// A slice of a part's footage, signed for upload and then stored. Deleting a row queues
/// its object for deletion from storage (a trigger, like files').
model RecordingSlice {
  sessionId  String        @map("session_id") @db.Uuid
  orgId      String        @map("org_id") @db.Uuid
  partIndex  Int           @map("part_index")
  index      Int
  /// Where it starts in its part's clock, and how long it lasts, in milliseconds.
  startMs    Int           @map("start_ms")
  durationMs Int           @map("duration_ms")
  /// What the upload was signed for (and storage holds it to).
  size       Int
  /// pending (signed) | uploaded
  status     String        @default("pending")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt DateTime?     @map("uploaded_at") @db.Timestamptz(3)
  part       RecordingPart @relation(fields: [sessionId, partIndex], references: [sessionId, index], onDelete: Cascade)

  @@id([sessionId, partIndex, index])
  @@map("recording_slice")
  @@schema("app")
}

/// An attempt at a shot, between Director's marks, and the take it was cut into.
model RecordingAttempt {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  sessionId   String           @map("session_id") @db.Uuid
  /// 1 for the session's first attempt, at any shot: the shoot screen numbers them, so a
  /// mark sent again names the attempt it was for.
  number      Int
  shotIndex   Int              @map("shot_index")
  partIndex   Int              @map("part_index")
  line        String?
  note        String?
  /// Director's marks, in the part's clock; no end while it's open, or when it ran to
  /// the part's end.
  startMs     Int              @map("start_ms")
  endMs       Int?             @map("end_ms")
  /// open | waiting (for its footage) | clipping | clipped | failed
  status      String           @default("open")
  /// Where the clipper cut it: the marks snapped to the first and last words.
  clipStartMs Int?             @map("clip_start_ms")
  clipEndMs   Int?             @map("clip_end_ms")
  /// The take's video (files.file, director-take-video) and the take.
  fileId      String?          @map("file_id") @db.Uuid
  takeId      String?          @map("take_id") @db.Uuid
  /// Why it couldn't be cut (an error code).
  error       String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  session     RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  part        RecordingPart    @relation(fields: [sessionId, partIndex], references: [sessionId, index], onDelete: Cascade)
  file        File?            @relation(fields: [fileId], references: [id], onDelete: SetNull)
  take        DirectorTake?    @relation(fields: [takeId], references: [id], onDelete: SetNull)

  @@unique([sessionId, number])
  /// At most one attempt open at a time.
  @@unique([sessionId], map: "recording_attempt_one_open", where: raw("status = 'open'"))
  @@index([fileId])
  @@index([takeId])
  @@map("recording_attempt")
  @@schema("app")
}

/// A stretch nothing was recorded (the member paused), in a part's clock: no attempt is
/// ever cut across one. No end while paused, or when the recorder had to start again.
model RecordingPause {
  sessionId String           @map("session_id") @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  partIndex Int              @map("part_index")
  startMs   Int              @map("start_ms")
  endMs     Int?             @map("end_ms")
  /// Resumed (a touch on the shoot screen), so no longer open.
  resumedAt DateTime?        @map("resumed_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  session   RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  part      RecordingPart    @relation(fields: [sessionId, partIndex], references: [sessionId, index], onDelete: Cascade)

  @@id([sessionId, partIndex, startMs])
  /// At most one pause open (not resumed) at a time.
  @@unique([sessionId], map: "recording_pause_one_open", where: raw("resumed_at IS NULL"))
  @@map("recording_pause")
  @@schema("app")
}

/// A member's version of a Director template: what Director remembers from the
/// conversation, the shots it changed for them, and the shots they skipped or left as gaps
/// (@repo/contracts yourVersionSchema, parsed when read). One per member and template.
model DirectorVersion {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  /// The template's YouTube video id (11 characters).
  videoId      String       @map("video_id")
  version      Json
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, videoId])
  @@index([userId])
  @@map("director_version")
  @@schema("app")
}
