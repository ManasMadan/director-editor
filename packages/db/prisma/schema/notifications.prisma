// Owner: apps/notifications: the email delivery log and the addresses it must not send
// to. It reads identity (name, email, locale) from auth.

/// One message on one channel. The idempotency key (job id + channel + recipient) makes
/// redelivered jobs send nothing twice, even over SMTP, which has no idempotency.
model NotificationDelivery {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  idempotencyKey    String   @unique @map("idempotency_key")
  channel           String
  template          String
  userId            String?  @map("user_id") @db.Uuid
  /// sending → sent | failed, or suppressed.
  status            String
  providerMessageId String?  @map("provider_message_id")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@map("delivery")
  @@schema("notifications")
}

/// Addresses we must not send to: hard bounces and spam complaints.
model NotificationSuppression {
  channel   String
  address   String
  /// bounce | complaint
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([channel, address])
  @@map("suppression")
  @@schema("notifications")
}
