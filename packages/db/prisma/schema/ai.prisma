// Owner: apps/ai (the Python service), which reads and writes it through SQLAlchemy
// models generated from the migrated database; Prisma owns the DDL, like every schema.
// Tenant tables: every query runs with app.org_id set (row-level security).

/// Tokens each model call used, for budgets and cost reporting.
model AiUsage {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  /// What used them, e.g. "director-plan".
  feature      String
  model        String
  inputTokens  Int          @map("input_tokens")
  outputTokens Int          @map("output_tokens")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("usage")
  @@schema("ai")
}

/// What deleted demo guests spent on models, by month, feature and model: their usage
/// rows go with their workspaces, so auth.purge_expired_guests adds them up here first.
model AiDemoUsage {
  /// The first day of the month (UTC).
  month        DateTime @db.Date
  feature      String
  model        String
  inputTokens  BigInt   @default(0) @map("input_tokens")
  outputTokens BigInt   @default(0) @map("output_tokens")

  @@id([month, feature, model])
  @@map("demo_usage")
  @@schema("ai")
}

/// Director: how to film one YouTube short, as Gemini worked it out from watching it.
/// One per workspace and video, so everyone in the workspace reuses the analysis: the
/// workspace's library of templates.
model DirectorPlan {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String                @map("org_id") @db.Uuid
  /// Who indexed it. A member indexes one short of their own (source user, not failed):
  /// the partial unique index below holds that, two requests racing included.
  createdBy    String?               @map("created_by") @db.Uuid
  /// The YouTube video id (11 characters); a created plan's is a random id of the same
  /// shape, so every route, take and cut keyed by it works the same.
  videoId      String                @map("video_id")
  /// seed (copied into every workspace, never anyone's index) | user | created (described
  /// by a member, counted apart from their one index)
  source       String                @default("user")
  /// A created plan's brief: what the member typed, their answers to Director and their
  /// photos' file ids ({text, messages, photos}).
  brief        Json?
  /// pending (queued) | analyzing | ready | failed
  status       String                @default("pending")
  /// How far indexing got, for the library: queued | watching | writing | ready | failed
  stage        String                @default("queued")
  /// Why the analysis failed (an error code).
  error        String?
  /// The shot plan (app/schemas.py ShotPlan), once ready.
  plan         Json?
  /// The model that wrote it.
  model        String?
  /// The short's original audio: ready (stored at audio_key) | failed | none (not tried)
  audioStatus  String                @default("none") @map("audio_status")
  /// Its object key in storage, once ready.
  audioKey     String?               @map("audio_key")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  takes        DirectorTake[]
  cuts         DirectorCut[]
  recordings   RecordingSession[]
  assets       DirectorAsset[]
  assetChoices DirectorAssetChoice[]

  @@unique([orgId, videoId])
  @@unique([createdBy], map: "director_plan_one_user_index", where: raw("source = 'user' AND status <> 'failed'"))
  @@index([orgId, id(sort: Desc)])
  @@map("director_plan")
  @@schema("ai")
}

/// One recorded clip or photo for a shot of a plan, and Gemini's review of it. Takes are
/// never replaced: a retake is another row, and the best-scored one is picked.
model DirectorTake {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  /// The shot's position in the plan (0-based).
  shotIndex    Int                @map("shot_index")
  /// The upload (files.file) holding the take.
  fileId       String             @map("file_id") @db.Uuid
  /// video | photo
  kind         String
  /// pending (queued) | reviewing | ready | failed
  status       String             @default("pending")
  error        String?
  /// The part of a video take worth keeping, in milliseconds from its start.
  bestStartMs  Int?               @map("best_start_ms")
  bestEndMs    Int?               @map("best_end_ms")
  /// 0 to 100: how closely the take follows the shot.
  score        Int?
  feedback     String?
  /// Why this take is (or isn't) the one to use, in a line: "the cleanest delivery, and
  /// you held the smile". What the editor shows under Director's pick.
  reason       String?
  /// When the member chose this take for its shot ("use the second one", said or typed
  /// while shooting): the shot's latest choice beats Director's pick.
  chosenAt     DateTime?          @map("chosen_at") @db.Timestamptz(3)
  /// shoot (an attempt marked while shooting, or a take filmed) | pass (found in the
  /// whole recording after Done, such as a great line said while rehearsing)
  origin       String             @default("shoot")
  /// What the take shows and says, written with its review, for finding it by
  /// description in the editor: transcript with word times, what's visible, moments,
  /// quality (apps/ai TakeIndex). Null for a take reviewed before the index existed.
  takeIndex    Json?              @map("take_index")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         DirectorPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  file         File               @relation(fields: [fileId], references: [id], onDelete: Cascade)
  /// The recorded attempt it was cut from (app schema), if it was.
  attempts     RecordingAttempt[]

  /// A file is one take: a clipped attempt's job run twice adds it once.
  @@unique([fileId], map: "director_take_one_per_file")
  @@index([orgId, id(sort: Desc)])
  @@index([planId, userId, shotIndex])
  @@index([userId])
  @@index([fileId])
  @@map("director_take")
  @@schema("ai")
}

/// A member's finished video of a plan: the take picked for each shot, rendered into one
/// upload, and how far publishing it to YouTube got.
model DirectorCut {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  planId         String       @map("plan_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  title          String
  /// The take picked for each shot used: [{shotIndex, takeId}].
  picks          Json
  /// The rendered video (files.file, purpose director-cut-video).
  fileId         String       @map("file_id") @db.Uuid
  durationMs     Int          @map("duration_ms")
  /// none | uploading | published | failed
  publishStatus  String       @default("none") @map("publish_status")
  /// The published video's id on YouTube.
  youtubeVideoId String?      @map("youtube_video_id")
  /// private | unlisted | public, as published.
  visibility     String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan           DirectorPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  file           File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([orgId, id(sort: Desc)])
  @@index([planId, userId])
  @@index([userId])
  @@index([fileId])
  @@map("director_cut")
  @@schema("ai")
}

/// An image made for one of a plan's assets (the plan's `assets`, apps/ai/app/schemas.py):
/// its default, drawn by Nano Banana from the asset's prompt right after the plan is
/// indexed, so it's there by the time anyone shoots. Counted per member against the daily
/// image limit (ai.images_today), and in ai.usage like every model call.
model DirectorAsset {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String                @map("org_id") @db.Uuid
  planId       String                @map("plan_id") @db.Uuid
  /// Whose daily limit it counts against: the member who indexed the plan.
  userId       String?               @map("user_id") @db.Uuid
  /// The asset's id in the plan ("chart").
  assetId      String                @map("asset_id")
  /// default (made after indexing, shared by the workspace); one of a member's own from
  /// the asset picker: created (drawn from their prompt), upload or stock; or storyboard
  /// (a created plan's card for a shot, its asset id the shot's storyboard id).
  origin       String                @default("default")
  /// pending (queued) | generating | ready | failed
  status       String                @default("pending")
  /// Its object key in storage, once ready: director-assets/<planId>/<assetId>.<ext> for a
  /// default, director-assets/<planId>/<assetId>/<id>.<ext> for a drawn or stock one, and
  /// files/<fileId> for an upload.
  objectKey    String?               @map("object_key")
  /// The model that drew it.
  model        String?
  /// Why it failed (an error code).
  error        String?
  /// What a created one was drawn from: the member's prompt, or how to change `baseId`.
  prompt       String?
  /// A created one's reference picture (an upload of the member's, files/<fileId>).
  referenceKey String?               @map("reference_key")
  /// The image a created one edits (another of the slot's images).
  baseId       String?               @map("base_id") @db.Uuid
  /// An upload's file (files.file, purpose director-asset-image).
  fileId       String?               @map("file_id") @db.Uuid
  /// A stock one's credit: {provider, author, authorUrl, pageUrl}.
  credit       Json?
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         DirectorPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  choices      DirectorAssetChoice[]

  @@unique([planId, assetId], map: "director_asset_one_default", where: raw("origin = 'default'"))
  @@index([orgId, id(sort: Desc)])
  @@index([planId])
  @@index([userId, createdAt])
  @@map("director_asset")
  @@schema("ai")
}

/// Which image a member uses in one of a plan's asset slots: the newest row of the slot
/// wins, and the ones before it are the slot's history (undo). No candidate is the
/// slot's default.
model DirectorAssetChoice {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  planId       String         @map("plan_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  /// The asset's id in the plan ("chart").
  assetId      String         @map("asset_id")
  candidateId  String?        @map("candidate_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         DirectorPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate    DirectorAsset? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([planId, userId, assetId, id(sort: Desc)])
  @@index([orgId, id(sort: Desc)])
  @@index([userId])
  @@index([candidateId])
  @@map("director_asset_choice")
  @@schema("ai")
}
