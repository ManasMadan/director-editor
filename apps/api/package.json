{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "description": "The HTTP API: authentication (better-auth) and the oRPC API defined in packages/contracts.",
  "scripts": {
    "dev": "tsdown --watch --on-success \"node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/telemetry.mjs dist/main.mjs\"",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/telemetry.mjs dist/main.mjs",
    "check-types": "tsc",
    "gen": "bun scripts/openapi.ts openapi.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --tags-filter=!files",
    "test:integration:files": "vitest run --project integration --tags-filter=files",
    "auth:schema": "bun --env-file=../../.env run auth generate --config src/auth/auth.cli.ts --adapter prisma --dialect postgresql --output ../../node_modules/.cache/auth-schema.prisma --yes",
    "seed": "LOG_LEVEL=warn node --env-file-if-exists=../../.env --enable-source-maps dist/seed.mjs",
    "secrets:reencrypt": "node --env-file-if-exists=../../.env --enable-source-maps dist/reencrypt.mjs",
    "load:users": "LOG_LEVEL=warn node --env-file-if-exists=../../.env --enable-source-maps dist/load-users.mjs",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/cimd": "catalog:",
    "@better-auth/expo": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/redis-storage": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@repo/ai-client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/nest-common": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "^5.2.1",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@repo/fake-stripe": "workspace:*",
    "@repo/testing": "workspace:*",
    "@repo/tsdown-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.7.6",
    "jose": "^6.2.12",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
