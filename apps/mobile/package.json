{
  "name": "@repo/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "The Expo app (iOS, Android and web): the same API, auth and translations as apps/web, through packages/client.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "bun --env-file=../../.env run sh -c 'exec expo start --port \"$EXPO_PORT\"'",
    "ios": "bun --env-file=../../.env run expo run:ios",
    "android": "bun --env-file=../../.env run expo run:android",
    "gen": "uniwind generate-artifacts --css ./global.css --dts ./uniwind-types.d.ts",
    "build:web": "bun --env-file=../../.env run expo export --platform web --output-dir dist",
    "serve:web": "bun --env-file=../../.env scripts/serve-web.ts",
    "check-types": "tsc",
    "test": "jest",
    "doctor": "expo-doctor",
    "lint": "expo-doctor && expo install --check",
    "test:e2e": "bun --env-file=../../.env run playwright test",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo/metro-runtime": "~57.0.16",
    "@hookform/resolvers": "^5.9.1",
    "@repo/client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/ui": "workspace:*",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.48.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-passkeys": "catalog:",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "catalog:",
    "uniwind": "^1.12.0",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-native/jest-preset": "0.86.3",
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "catalog:",
    "babel-jest": "^29.7.0",
    "expo-doctor": "^1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.0.0",
    "typescript": "catalog:"
  }
}
