{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "description": "The web app: renders UI only. All data and logic come from apps/api through packages/client.",
  "scripts": {
    "dev": "bun --env-file=../../.env run sh -c 'exec next dev --port \"$WEB_PORT\"'",
    "build": "bun --env-file=../../.env run next build && bun run scripts/copy-static.ts",
    "start": "bun --env-file=../../.env run sh -c 'PORT=\"$WEB_PORT\" exec node .next/standalone/apps/web/server.js'",
    "check-types": "SKIP_ENV_VALIDATION=1 next typegen && tsc",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project 'browser*' --tags-filter=!files",
    "test:integration:files": "vitest run --project 'browser*' --tags-filter=files",
    "test:e2e": "bun --env-file=../../.env run playwright test",
    "budget": "bun ../../scripts/bundle-budget.ts",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@repo/client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/ui": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "geist": "^1.7.2",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "^4.14.7",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.89.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@repo/db": "workspace:*",
    "@repo/fake-stripe": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "pg": "^8.23.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "standardwebhooks": "^1.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
