    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.agekey)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.tfstate*)",
      "Read(./load/.sessions.json)",
      "Read(~/.config/sops/**)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(sops -d*)",
      "Bash(sops decrypt*)"
    ]
